    <SwBase>..\..\..\..\..\..\Program Files</SwBase>
    <SwDir Condition="'$(SwDir)' == '' And Exists('$(SwBase)\SOLIDWORKS Corp 2021\SOLIDWORKS\SolidWorks.Interop.sldworks.dll')">$(SwBase)\SOLIDWORKS Corp 2021\SOLIDWORKS</SwDir>
    <SwDir Condition="'$(SwDir)' == '' And Exists('$(SwBase)\SOLIDWORKS Corp\SOLIDWORKS\SolidWorks.Interop.sldworks.dll')">$(SwBase)\SOLIDWORKS Corp\SOLIDWORKS</SwDir>
    <SwDir Condition="'$(SwDir)' == ''">$(SwBase)\SOLIDWORKS Corp\SOLIDWORKS</SwDir>
  </PropertyGroup>
